# 海克斯攻略站 —— 环境变量示例
# 复制这个文件内容，在服务器上存成 /root/.env（去掉注释就能用）
# 注意：.env 里包含邮箱授权码（SMTP_PASS），千万别提交到公开仓库/泄露

# ==== SMTP 发信（真发验证码）====
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=19162860223@163.com
SMTP_PASS=你的16位邮箱授权码
MAIL_FROM=19162860223@163.com

# ==== 备案号（域名 ICP 备案通过后填）====
ICP_NUMBER=你的ICP备案号

# ==============================
# 更多环境变量（可选，系统已默认）
# PATCH_VERSION=16.16
# DRAGON_VER=16.17.1
